# Copy to .env and adjust.
# Pooled URL for app traffic (Neon/Supabase pooler host). For local Postgres, use the same value as DIRECT_DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dcmn"
# Direct (non-pooled) URL — required for Prisma interactive transactions when DATABASE_URL uses a pooler.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dcmn"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
