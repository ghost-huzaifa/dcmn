generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserPlanStatus {
  PENDING_DEPOSIT
  ACTIVE
  ENDED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WalletTxnType {
  DEPOSIT
  WITHDRAW
  TASK_EARN
  REFERRAL
  ADJUSTMENT
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String?  @unique
  phone          String?
  passwordHash   String
  role           Role     @default(USER)
  referenceCode  String   @unique
  referrerId     String?
  referrer       User?    @relation("Referrals", fields: [referrerId], references: [id])
  referrals      User[]   @relation("Referrals")
  balance        Decimal  @default(0) @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userPlans             UserPlan[]
  depositRequests       DepositRequest[]
  withdrawRequests      WithdrawRequest[]
  walletTransactions    WalletTransaction[]
  dailyTaskStates       DailyTaskState[]
  taskCompletions       UserTaskCompletion[]
  depositsReviewed      DepositRequest[]  @relation("DepositReviewedBy")
  withdrawalsReviewed   WithdrawRequest[] @relation("WithdrawReviewedBy")
}

model Plan {
  id               String   @id @default(cuid())
  code             String   @unique
  securityDeposit  Decimal  @db.Decimal(18, 2)
  taskCount        Int
  taskCommission   Decimal  @db.Decimal(18, 2)
  dailyWage        Decimal  @db.Decimal(18, 2)

  userPlans       UserPlan[]
  depositRequests DepositRequest[]
}

model UserPlan {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan             @relation(fields: [planId], references: [id])
  status             UserPlanStatus   @default(PENDING_DEPOSIT)
  depositRequestId   String?          @unique
  depositRequest     DepositRequest?  @relation(fields: [depositRequestId], references: [id])
  startedAt          DateTime?
  endedAt            DateTime?
  referralPaidAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  dailyTaskStates DailyTaskState[]
  taskCompletions UserTaskCompletion[]

  @@index([userId])
  @@index([status])
}

model DepositRequest {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String?
  plan           Plan?         @relation(fields: [planId], references: [id])
  amount         Decimal       @db.Decimal(18, 2)
  note           String?       @db.Text
  screenshotData String?       @db.Text
  screenshotMime String?
  status         RequestStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?         @relation("DepositReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  userPlan UserPlan?

  @@index([status])
  @@index([userId])
}

model WithdrawRequest {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(18, 2)
  bankDetails    String        @db.Text
  status         RequestStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?         @relation("WithdrawReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([userId])
}

model WalletTransaction {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         WalletTxnType
  amount       Decimal       @db.Decimal(18, 2)
  balanceAfter Decimal       @db.Decimal(18, 2)
  memo         String?
  depositId    String?
  withdrawId   String?
  userPlanId   String?
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([type])
}

model DailyTaskState {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlanId     String
  userPlan       UserPlan @relation(fields: [userPlanId], references: [id], onDelete: Cascade)
  dateKey        String
  completedCount Int      @default(0)

  @@unique([userPlanId, dateKey])
  @@index([userId])
}

model AdminTask {
  id        String   @id @default(cuid())
  dateKey   String
  title     String
  videoUrl  String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  completions UserTaskCompletion[]

  @@index([dateKey, position])
}

model UserTaskCompletion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlanId   String
  userPlan     UserPlan @relation(fields: [userPlanId], references: [id], onDelete: Cascade)
  taskId       String
  task         AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  dateKey      String
  earnedAmount Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  @@unique([userId, taskId])
  @@index([userId, dateKey])
  @@index([userPlanId])
}

model SiteSettings {
  id                    String   @id @default("singleton")
  bankDisplayText       String   @default("") @db.Text
  whatsappNumber        String   @default("+447836532206")
  welcomeBonusPct       Decimal  @default(7) @db.Decimal(5, 2)
  refLevel1Pct          Decimal  @default(12) @db.Decimal(5, 2)
  refLevel2Pct          Decimal  @default(4) @db.Decimal(5, 2)
  refLevel3Pct          Decimal  @default(1) @db.Decimal(5, 2)
  taskOverrideLevel1Pct Decimal  @default(5) @db.Decimal(5, 2)
  taskOverrideLevel2Pct Decimal  @default(2) @db.Decimal(5, 2)
  taskOverrideLevel3Pct Decimal  @default(1) @db.Decimal(5, 2)
  updatedAt             DateTime @updatedAt
}
